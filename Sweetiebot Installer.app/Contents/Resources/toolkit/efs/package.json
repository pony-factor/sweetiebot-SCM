{
  "name": "sweetiebot-scm",
  "displayName": "Sweetiebot SCM",
  "description": "Local semantic and hybrid workspace search in the Source Control sidebar using Ollama.",
  "version": "0.3.2",
  "publisher": "pony-factor",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:sweetiebot.returnHome",
    "onCommand:sweetiebot.openPullRequestChat",
    "onCommand:sweetiebot.openPullRequestBatchChat",
    "onCommand:sweetiebot.closeAllEditors",
    "onCommand:sweetiebot.prepareCodexCommit",
    "onCommand:sweetiebot.generateCodexCommitMessage",
    "onCommand:sweetiebot.previewCommitSpellcheck",
    "onCommand:sweetiebot.createBranch",
    "onCommand:sweetiebot.publishBranch",
    "onCommand:sweetiebot.deleteBranch",
    "onCommand:sweetiebot.autoPullClean",
    "onCommand:sweetiebot.syncBranch",
    "onView:scmToolkit.workspaceSearch",
    "onView:scmToolkit.ponyInfo",
    "onCommand:sweetiebot.openSettings",
    "onStartupFinished",
    "onCommand:sweetiebot.workspaceSearch.clearIndex",
    "onCommand:sweetiebot.chatgpt.searchRepositories",
    "onCommand:sweetiebot.squashMergeSelectedPullRequest",
    "onCommand:sweetiebot.squashMergePullRequest",
    "onUri",
    "onCommand:sweetiebot.openFileOnGitHub",
    "onCommand:scmToolkit.returnHome",
    "onCommand:scmToolkit.openPullRequestChat",
    "onCommand:scmToolkit.openPullRequestBatchChat",
    "onCommand:scmToolkit.closeAllEditors",
    "onCommand:scmToolkit.prepareCodexCommit",
    "onCommand:scmToolkit.generateCodexCommitMessage",
    "onCommand:scmToolkit.createBranch",
    "onCommand:scmToolkit.publishBranch",
    "onCommand:scmToolkit.deleteBranch",
    "onCommand:scmToolkit.autoPullClean",
    "onCommand:scmToolkit.syncBranch",
    "onCommand:scmToolkit.openSettings",
    "onCommand:scmToolkit.workspaceSearch.clearIndex",
    "onCommand:scmToolkit.chatgpt.searchRepositories",
    "onCommand:scmToolkit.squashMergeSelectedPullRequest",
    "onCommand:scmToolkit.squashMergePullRequest",
    "onCommand:scmToolkit.openFileOnGitHub",
    "onCommand:sweetiebot.beginCommit",
    "onCommand:scmToolkit.beginCommit",
    "onCommand:sweetiebot.checkCommitLimits",
    "onCommand:scmToolkit.checkCommitLimits",
    "onCommand:sweetiebot.endCommit",
    "onCommand:scmToolkit.endCommit"
  ],
  "contributes": {
    "views": {
      "scm": [
        {
          "id": "scmToolkit.workspaceSearch",
          "name": "Workspace Search",
          "type": "webview",
          "visibility": "visible",
          "contextualTitle": "SCM Workspace Search"
        },
        {
          "id": "scmToolkit.ponyInfo",
          "name": "Pony Info",
          "type": "webview",
          "visibility": "collapsed",
          "when": "scmToolkit.hasPonyProfile",
          "contextualTitle": "Sweetiebot Pony Info"
        }
      ]
    },
    "commands": [
      {
        "command": "sweetiebot.openSettings",
        "title": "Open Sweetiebot SCM Settings",
        "icon": "$(gear)"
      },
      {
        "command": "sweetiebot.workspaceSearch.clearIndex",
        "title": "Clear Workspace Search Index",
        "icon": "$(trash)"
      },
      {
        "command": "sweetiebot.chatgpt.searchRepositories",
        "title": "Search Linked GitHub Repositories",
        "icon": "$(github)"
      },
      {
        "command": "sweetiebot.squashMergeSelectedPullRequest",
        "title": "Squash and Merge into main",
        "icon": "$(git-merge)"
      },
      {
        "command": "sweetiebot.openPullRequestBatchChat",
        "title": "Squash Selected Pull Requests with ChatGPT",
        "icon": {
          "light": "media/merge-prs-light.svg",
          "dark": "media/merge-prs-dark.svg"
        }
      },
      {
        "command": "sweetiebot.closeAllEditors",
        "title": "Close All Editors",
        "icon": "$(close-all)"
      },
      {
        "command": "sweetiebot.openFileOnGitHub",
        "title": "Open File on GitHub",
        "icon": "$(github)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sweetiebot.workspaceSearch.clearIndex",
          "when": "view == scmToolkit.workspaceSearch",
          "group": "navigation@1"
        },
        {
          "command": "sweetiebot.openPullRequestBatchChat",
          "when": "view == pr:github && !isWeb",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "sweetiebot.squashMergeSelectedPullRequest",
          "when": "view == pr:github && viewItem =~ /pullrequest/ && config.scmToolkit.pullRequestQuickMerge && !isWeb",
          "group": "inline@2"
        }
      ],
      "editor/title": [
        {
          "command": "sweetiebot.closeAllEditors",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "sweetiebot.openFileOnGitHub",
          "when": "resourceScheme == file",
          "group": "navigation@50"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "sweetiebot.openFileOnGitHub",
          "when": "resourceScheme == file",
          "group": "navigation@50"
        }
      ]
    },
    "configuration": {
      "title": "Sweetiebot SCM",
      "properties": {
        "scmToolkit.automaticBranchCleanup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically remove eligible merged local branches on startup and every ten minutes."
        },
        "scmToolkit.workspaceSearch.autoReindex": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh the workspace search index every two minutes."
        },
        "scmToolkit.autoPublishNewBranches": {
          "type": "boolean",
          "default": false,
          "description": "Automatically publish newly selected local branches to the configured Git remote."
        },
        "scmToolkit.codexKeepAwake": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Keep macOS awake while Codex is working. Releases idle-sleep prevention when all tasks finish; the display can still turn off."
        },
        "scmToolkit.workspaceSearch.embeddingModel": {
          "type": "string",
          "default": "qwen3-embedding:0.6b",
          "description": "Ollama embedding model used to index and search workspace content."
        },
        "scmToolkit.workspaceSearch.askOllama": {
          "type": "boolean",
          "default": false,
          "description": "Show the Ask Ollama action. Requires an explicit chat model."
        },
        "scmToolkit.workspaceSearch.chatModel": {
          "type": "string",
          "default": "",
          "description": "Ollama chat model used by Ask Ollama. Required when Ask Ollama is enabled."
        },
        "scmToolkit.workspaceSearch.ollamaUrl": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Loopback Ollama server URL. Only localhost and loopback addresses are accepted."
        },
        "scmToolkit.workspaceSearch.mode": {
          "type": "string",
          "enum": [
            "hybrid",
            "semantic",
            "exact"
          ],
          "default": "hybrid",
          "description": "Default ranking mode. Hybrid combines semantic and exact term matching."
        },
        "scmToolkit.workspaceSearch.resultLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "description": "Maximum number of result passages shown."
        },
        "scmToolkit.workspaceSearch.maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000,
          "default": 5000,
          "description": "Maximum number of workspace files considered for indexing."
        },
        "scmToolkit.workspaceSearch.maxFileSizeMB": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100,
          "default": 10,
          "description": "Maximum file size indexed directly. External document extractors may still impose their own limits."
        },
        "scmToolkit.workspaceSearch.exclude": {
          "type": "string",
          "default": "**/{.git,node_modules,dist,build,out,target,.venv,venv,__pycache__,coverage}/**",
          "description": "Glob excluded from workspace indexing."
        },
        "scmToolkit.openPanelOnStartup": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Open Sweetie Bot / Source Control when each VS Code window starts, then return keyboard focus to the editor."
        },
        "scmToolkit.pullRequestAutoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Refresh the GitHub Pull Requests list when visible and focused, and every 5 seconds while active."
        },
        "scmToolkit.pullRequestQuickMerge": {
          "type": "boolean",
          "default": true,
          "description": "Show an inline button to squash and merge a GitHub pull request into main without opening it."
        },
        "scmToolkit.automaticAppRepair": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "Automatically install Sweetie Bot updates from main and restore customizations after VS Code and extension updates. Reload when prompted to apply changes."
        },
        "scmToolkit.messagePlaceholder": {
          "type": "string",
          "default": "Message",
          "description": "Text shown in the Source Control commit-message box. Leave blank to use VS Code's default."
        },
        "scmToolkit.commitButtonLabel": {
          "type": "string",
          "default": "Send",
          "description": "Text shown on the primary Source Control commit action."
        },
        "scmToolkit.commitAndSendButtonLabel": {
          "type": "string",
          "default": "Send",
          "description": "Text shown on the primary commit action when git.postCommitCommand is push."
        }
      }
    }
  }
}
